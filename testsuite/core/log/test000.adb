pragma Ada_2022;

with Ada.Text_IO;

with PolyORB.Initialization;
with PolyORB.Parameters.File;
with PolyORB.Parameters.Initialization;
with PolyORB.Log;

with PolyORB.Utils.Report;

procedure Test000 is

   use PolyORB.Initialization;
   use PolyORB.Utils.Report;

   package L is new PolyORB.Log.Facility_Log ("test.log");

begin
   Output ("Enabled", L.Enabled);

   Initialize_World;

   Output ("not Enabled", not L.Enabled);

   End_Report;
end Test000;
